# Все переменные необязательны: без ключа работает весь сценарий, кроме текста модели и голоса.
# Скопируйте файл в .env (в корне репозитория) и впишите свой ключ. Файл .env в репозиторий не попадает.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Модель разбора сценария; пусто — та же, что OPENAI_MODEL. Быстрее — gpt-4.1 (около 8 с)
OPENAI_EXPLAIN_MODEL=
OPENAI_REASONING_EFFORT=low
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
