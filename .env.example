# Все переменные необязательны: без ключа работает всё, кроме текста модели и голоса.
# Скопируйте файл в .env и впишите свой ключ. Файл .env в репозиторий не попадает.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_SECONDS=30
