# Все переменные необязательны: без ключа работает весь сценарий, кроме текста модели и голоса.
# Скопируйте файл в .env (в корне репозитория) и впишите свой ключ. Файл .env в репозиторий не попадает.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Быстрая модель для короткого структурированного разбора сценария
OPENAI_EXPLAIN_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
