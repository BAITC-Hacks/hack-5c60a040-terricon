# Скопировать в .env (в КОРНЕ репо, рядом с этим файлом) и заполнить ключи. .env в git не попадает.
# Движок читает ../.env от папки server/ (config.py). Пути ниже — от папки server/.
# Новая переменная → строка здесь + поле в server/config.py. Новый внешний API → сюда сразу.

# === СЕРВЕР ===
# ПЕРЕНОСИМОСТЬ (venv ↔ docker): код НЕ знает окружения, все адреса и пути — отсюда.
# Никаких абсолютных путей, 127.0.0.1 и портов цифрой в коде. Переезд в докер = другой .env, код не меняется.
HOST=0.0.0.0
# 0.0.0.0 — слушать снаружи (нужно для докера). В venv тоже работает. НЕ ставить 127.0.0.1.
PORT=8000
# адреса экрана (CORS); экран на другом порту/адресе → дописать через запятую
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./app.db
# данные кейса (лежат в server/data/, идут в репо). Путь ОТНОСИТЕЛЬНЫЙ от server/, не абсолютный.
# venv: data/   докер: /app/data (задаётся здесь, в коде остаётся DATA_PATH)
DATA_PATH=data/

# === LLM (цепочка: основной -> запасной -> DEMO_MODE) ===
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Параметры существующего Streamlit-экрана.
OPENAI_REASONING_EFFORT=low
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_SECONDS=30
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_TIMEOUT_SEC=30
LLM_MAX_RETRIES=2

# === ВНЕШНИЕ API КЕЙСА (заполнить после разбора кейса) ===
# <ИМЯ>_API_KEY=
# <ИМЯ>_API_URL=

# === СТРАХОВКА ДЛЯ ДЕМО ===
# true: движок отвечает заготовками без ключей LLM (обязательно для запуска судьёй без ключей)
DEMO_MODE=false

# Экран (Vite) читает только VITE_* из web/.env.local (не из этого файла):
#   VITE_API_URL=http://localhost:8000
